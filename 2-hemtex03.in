go atlas

mesh
x.mesh loc=0.0 spac=0.05
x.mesh loc=0.75 spac=0.05

y.mesh loc=-0.02  spac=0.01
y.mesh loc=0.0    spac=0.001
y.mesh loc=0.005  spac=0.001
y.mesh loc=0.035  spac=0.001
y.mesh loc=0.036  spac=0.0005
y.mesh loc=0.038  spac=0.0005
y.mesh loc=0.056  spac=0.001
y.mesh loc=0.226  spac=0.05
y.mesh loc=0.743  spac=0.05

region num=1 material=oxide  y.min=-0.02 y.max=0.0
region num=2 material=AlGaAs y.min=0.000 y.max=0.005 x.comp=0.22
region num=3 material=AlGaAs y.min=0.005 y.max=0.035 x.comp=0.22
region num=4 material=AlGaAs y.min=0.035 y.max=0.036 x.comp=0.22
region num=5 material=AlGaAs y.min=0.036 y.max=0.038 x.comp=0.22
region num=6 material=InGaAs y.min=0.038 y.max=0.056 x.comp=0.18
region num=7 material=AlGaAs y.min=0.056 y.max=0.226 x.comp=0.22
region num=8 material=GaAs   y.min=0.226 y.max=0.743

elec num=1 name=source x.min=0   x.max=0   y.min=0.0 y.max=0.05
elec num=2 name=gate   x.min=0.1 x.max=0.6 y.min=0.0 y.max=0.0
elec num=3 name=drain  x.min=0.75 x.max=0.75 y.min=0.0 y.max=0.05

doping uniform y.min=0.000 y.max=0.035 n.type conc=1e18
doping uniform y.min=0.035 y.max=0.036 n.type conc=5e18
doping uniform y.min=0.036 y.max=0.056 n.type conc=1e15
doping uniform y.min=0.056 y.max=0.226 n.type conc=1e16
doping uniform x.min=0.0 x.max=0.05 y.min=0.038 y.max=0.056 n.type conc=1e18
doping uniform x.min=0.70 x.max=0.75 y.min=0.038 y.max=0.056 n.type conc=1e18

interface x.min=0 x.max=0.75 y.min=-0.01 y.max=0.005 qf=-1e12

models srh conmob fldmob bgn fermi

material taun0=1e-9 taup0=1e-9
material material=GaAs affinity=4.07 eg300=1.424
material material=AlGaAs affinity=3.75 eg300=1.90
material material=InGaAs affinity=4.15 eg300=0.85

contact name=gate workfun=4.73

log outf=pseudo_1.log
method gummel newton trap itlim=20
output con.band val.band

solve vgate=0.0
save outf="vd_0.str"

solve vdrain=0.05
save outf="vd_0p05.str"

solve vdrain=0.10
save outf="vd_0p1.str"

solve vdrain=0.20
save outf="vd_0p2.str"

solve vdrain=0.30
save outf="vd_0p3.str"

solve vdrain=0.50
save outf="vd_0p5.str"

solve vdrain=1.0
save outf="vd_1p0.str"

solve vdrain=2.0
save outf="vd_2p0.str"

log outf=pseudo_2.log
solve init

solve vgate=-1.0 vdrain=0.1
save outf="vg_-1p0.str"

solve vgate=-0.8
save outf="vg_-0p8.str"

solve vgate=-0.6
save outf="vg_-0p6.str"

solve vgate=-0.4
save outf="vg_-0p4.str"

solve vgate=-0.2
save outf="vg_-0p2.str"

solve vgate=0.0
save outf="vg_0p0.str"

solve vgate=0.2
save outf="vg_0p2.str"

solve vgate=0.4
save outf="vg_0p4.str"

solve vgate=0.6
save outf="vg_0p6.str"

solve vgate=0.8
solve vgate=1
solve vgate=1.2

quit
